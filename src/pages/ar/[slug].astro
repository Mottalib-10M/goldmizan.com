---
/** Pages de contenu (ar) : un fichier de src/content/pages/ = une page (CONTRIBUTING-PAGES.md). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/pages';
import type { PageDef } from '../../lib/page-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.ar.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="ar" />
