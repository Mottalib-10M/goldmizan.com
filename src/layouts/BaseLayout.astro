---
import { displayDate } from '../lib/format';
import '../styles/global.css';
import { SITE_URL, YEAR, LAST_UPDATED, BING_VERIFY_CODE, GOOGLE_VERIFY_CODE, CONSENT_MODE, CLARITY_ID, THEME_COLOR, AUTHOR_NAME, SITE_NAMES, LANG_TAGS, OG_LOCALES } from '../data/site-config';
import { t } from '../i18n/ui';
import { altPaths, route, LOCALES, DEFAULT_LOCALE, dirOf, type Locale } from '../i18n/routes';
import { navCategories, navDirect, footerColumns } from '../i18n/nav';

interface BreadcrumbItem { label: string; href?: string }
interface Props { title: string; description: string; lang: Locale; canonical?: string; ogImage?: string; noindex?: boolean; jsonLd?: string[]; breadcrumbs?: BreadcrumbItem[] }
const { title, description, lang, canonical, ogImage, noindex = false, jsonLd = [], breadcrumbs = [] } = Astro.props;
const ui = t(lang);
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? `${SITE_URL}${pathname}`;
const ogImageUrl = ogImage ?? `${SITE_URL}/og-${lang}.png`;
const alts = altPaths(pathname);
const homeHref = route('home', lang);
const cats = navCategories(lang); const direct = navDirect(lang); const footerCols = footerColumns(lang);
const other = LOCALES.find((l) => l !== lang)!;
const otherHref = alts?.[other] ?? route('home', other);
// Un emplacement passé sous condition compte comme présent pour Astro.slots.has : on regarde ce
// qu'il rend, sinon une rangée vide s'ajoute au-dessus du titre (trame, RECETTE §10.3).
const slotDate = Astro.slots.has('crumb-aside') ? (await Astro.slots.render('crumb-aside')).trim() : '';
---
<!doctype html>
<html lang={LANG_TAGS[lang]} dir={dirOf(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta name="author" content={AUTHOR_NAME} />
    {BING_VERIFY_CODE && <meta name="msvalidate.01" content={BING_VERIFY_CODE} />}
    {GOOGLE_VERIFY_CODE && <meta name="google-site-verification" content={GOOGLE_VERIFY_CODE} />}
    {alts && (<>
      {LOCALES.filter((l) => alts[l]).map((l) => <link rel="alternate" hreflang={LANG_TAGS[l]} href={`${SITE_URL}${alts[l]}`} />)}
      <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alts[DEFAULT_LOCALE]}`} />
    </>)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:site_name" content={SITE_NAMES[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {lang === 'ar'
      ? <link rel="preload" href="/fonts/sans-arabic-var.woff2" as="font" type="font/woff2" crossorigin />
      : <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preconnect" href="https://api.gold-api.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={ld} />)}
    {/* Régime 'none' (RECETTE §15.6) : aucun bandeau, aucun cookie ; Clarity sans consentement si un identifiant est posé. */}
    {CLARITY_ID && CONSENT_MODE === 'none' && (
      <script is:inline set:html={`(function(){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'denied'});var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/${CLARITY_ID}';document.head.appendChild(s);})();`} />
    )}
  </head>
  <body class="min-h-screen bg-white text-navy-900 antialiased" data-clarity-mask="true">
    <a href="#main-content" class="skip-link">{ui.skipToContent}</a>
    <header>
    <nav class="fixed top-0 z-50 w-full border-b border-navy-200 bg-white" aria-label={ui.mainNav}>
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href={homeHref} class="flex items-center gap-2 font-bold text-navy-900">
          <img src="/logo.svg" class="h-8 w-8" width="32" height="32" alt="" />
          <span>{SITE_NAMES[lang]}</span>
        </a>
        <div class="hidden items-center gap-1 lg:flex">
          {cats.map((cat, idx) => (
            <div class="nav-dropdown relative">
              <button class="nav-dropdown-trigger flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-navy-700 hover:bg-navy-50 hover:text-navy-900" aria-haspopup="true" aria-expanded="false">
                {cat.label}<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class={`nav-dropdown-panel absolute top-full z-50 mt-1 hidden w-72 rounded-lg border border-navy-200 bg-white p-3 ${idx >= cats.length - 1 ? 'end-0' : 'start-0'}`}>
                <div class="space-y-0.5">{cat.links.map((l) => <a href={l.href} class="block rounded px-3 py-2 text-sm text-navy-700 hover:bg-accent-50 hover:text-accent-800">{l.label}</a>)}</div>
              </div>
            </div>
          ))}
          {direct.map((l) => <a href={l.href} class="rounded-lg px-3 py-2 text-sm font-medium text-navy-700 hover:bg-navy-50 hover:text-navy-900">{l.label}</a>)}
          <a href={otherHref} hreflang={LANG_TAGS[other]} lang={LANG_TAGS[other]} class="ms-2 rounded-lg border border-navy-200 px-2.5 py-1.5 text-xs font-semibold text-navy-700 hover:bg-navy-50">{ui.otherLang}</a>
        </div>
        <div class="flex items-center gap-2 lg:hidden">
          <a href={otherHref} hreflang={LANG_TAGS[other]} lang={LANG_TAGS[other]} class="rounded-lg border border-navy-200 px-2 py-1 text-xs font-semibold text-navy-700">{ui.otherLang}</a>
          <button id="mobile-menu-toggle" class="p-2 text-navy-700" aria-label={ui.menuOpen} aria-expanded="false" aria-controls="mobile-menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-navy-200 bg-white px-4 pb-4 lg:hidden">
        {cats.map((cat) => (
          <div class="border-b border-navy-100 py-2">
            <button class="mobile-section-toggle flex w-full items-center justify-between py-2 text-sm font-semibold text-navy-900" aria-expanded="false">{cat.label}<svg class="mobile-chevron h-4 w-4 text-navy-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button>
            <div class="mobile-section-content hidden space-y-0.5 pb-2 ps-2">{cat.links.map((l) => <a href={l.href} class="block rounded py-1.5 ps-2 text-sm text-navy-700 hover:text-accent-700">{l.label}</a>)}</div>
          </div>
        ))}
        {direct.map((l) => <div class="border-b border-navy-100 py-2"><a href={l.href} class="block py-2 text-sm font-semibold text-navy-900">{l.label}</a></div>)}
      </div>
    </nav>
    </header>
    <main id="main-content" class="pt-16">
      {(breadcrumbs.length > 0 || slotDate) && (
        <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 px-4 pt-3">{breadcrumbs.length > 0 && <nav aria-label={ui.breadcrumbLabel}>
          <ol class="flex flex-wrap items-center gap-1 text-sm text-navy-600">
            <li><a href={homeHref} class="hover:text-navy-900">{ui.breadcrumbHome}</a></li>
            {breadcrumbs.map((item) => (<li class="flex items-center gap-1"><span aria-hidden="true">/</span>{item.href ? <a href={item.href} class="hover:text-navy-900">{item.label}</a> : <span class="text-navy-800" aria-current="page">{item.label}</span>}</li>))}
          </ol>
        </nav>}{slotDate && <Fragment set:html={slotDate} />}</div>
      )}
      <slot />
    </main>
    <footer class="mt-16 border-t border-navy-200 bg-navy-50">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          {footerCols.map((col) => (<div><h2 class="mb-3 text-sm font-semibold text-navy-900">{col.label}</h2><ul class="space-y-2 text-sm text-navy-700">{col.links.map((l) => <li><a href={l.href} class="hover:text-navy-900">{l.label}</a></li>)}</ul></div>))}
        </div>
        <div class="mt-8 border-t border-navy-200 pt-8">
          <div class="flex flex-col items-center gap-2 text-center text-sm text-navy-600">
            <p>{ui.footerSources} · {YEAR}</p>
            <p>{ui.footerBrowser}</p>
            <p>{ui.asOf} {YEAR}{lang === 'ar' ? '،' : ','} {ui.lastUpdated} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, lang)}</time></p>
            <p>&copy; {YEAR} {SITE_NAMES[lang]}. {ui.footerDisclaimer}</p>
            <p><a href={otherHref} hreflang={LANG_TAGS[other]} lang={LANG_TAGS[other]} class="underline hover:text-navy-900">{lang === 'ar' ? `English version, updated ${displayDate(LAST_UPDATED, 'en')}` : `${ui.otherLangTitle}، آخر تحديث ${displayDate(LAST_UPDATED, 'ar')}`}</a></p>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('mobile-menu-toggle'); const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => { const hidden = menu?.classList.toggle('hidden'); toggle.setAttribute('aria-expanded', hidden ? 'false' : 'true'); });
      document.querySelectorAll('.mobile-section-toggle').forEach((btn) => { btn.addEventListener('click', () => { const c = btn.nextElementSibling; const open = c?.classList.toggle('hidden') === false; btn.setAttribute('aria-expanded', open ? 'true' : 'false'); btn.querySelector('.mobile-chevron')?.classList.toggle('rotate-180'); }); });
      const closeAll = () => document.querySelectorAll('.nav-dropdown-panel').forEach((p) => p.classList.add('hidden'));
      document.querySelectorAll('.nav-dropdown').forEach((dd) => { const trigger = dd.querySelector('.nav-dropdown-trigger'); const panel = dd.querySelector('.nav-dropdown-panel'); let to: ReturnType<typeof setTimeout>;
        dd.addEventListener('mouseenter', () => { clearTimeout(to); closeAll(); panel?.classList.remove('hidden'); });
        dd.addEventListener('mouseleave', () => { to = setTimeout(() => panel?.classList.add('hidden'), 150); });
        trigger?.addEventListener('click', () => { const h = panel?.classList.contains('hidden'); closeAll(); if (h) panel?.classList.remove('hidden'); }); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
      document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.nav-dropdown')) closeAll(); });
    </script>
  </body>
</html>
